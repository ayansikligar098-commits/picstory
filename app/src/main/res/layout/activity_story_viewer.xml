<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/ivStory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:scaleType="fitCenter" />

    <!-- Video stories: same full-screen area as the photo view.
         Auto-plays with sound; the timer follows the video's length. -->
    <VideoView
        android:id="@+id/vvStory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:visibility="gone" />

    <!-- No full-height overlay tap zones here: in v1.9 two transparent
         Buttons (btnPrev/btnNext, 120dp x full height) sat under the bottom
         bar and swallowed taps meant for the like button (same class of
         bug as the v1.8 Messages icon). Prev/next is now handled by tap
         zones on the story image itself (see StoryViewerActivity), so
         nothing can sit between the user's finger and the like button. -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="12dp">

        <ProgressBar
            android:id="@+id/pbStory"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progressDrawable="@drawable/story_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStoryAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/avatar_circle"
                android:gravity="center"
                android:text="?"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivStoryAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Profile photo"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStoryName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStoryTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDeleteStory"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:text="🗑"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:text="✕"
                android:textColor="@color/white"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvViewers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom bar: like + reply (other people's stories only). -->
    <LinearLayout
        android:id="@+id/storyBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnLike"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:text="♡ 0"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etStoryComment"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/edit_bg"
            android:hint="Reply to story…"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/white"
            android:textColorHint="#CCFFFFFF" />

        <Button
            android:id="@+id/btnSendStoryComment"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_primary"
            android:text="➤"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
